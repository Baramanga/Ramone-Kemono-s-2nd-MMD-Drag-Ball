	#make sure the tiles on the ceiling cast shadow on creature
	setf t10a 90.96 #tile floor start moving foward in a loop, creating train lighting effect

setf t11 102.03 #return to palace, spawn palace centerpiece
setf t12 111.96 #spawn in light effect on center piece, #every other tile open up, 

	setf t12a 112.68 #tiles move in a cylinder tunnel

setf t13 123.01 #flash red with inverted color demon lord screen effect, + glowing eyes +crown
setf t14 124.47 #blood ocean 2

setf t15 134.00 #pause +monochrome screen
setf t16 136.00 #pause ends

	setf t16a ($t1a-$t1+$t15) #flash1 -> spawn by rows on sky
	setf t16b ($t1b-$t1+$t15) #flash2
	
	setf t16c ($t1c-$t1+$t15) #flash3
