#import 2ndCamera_Control_14
setf distfactor 1.3
camera MMD_Camera
	life 1000 #seconds real time
	yaw 0
	pitch 0
	roll  0
	distance (1.7*$distfactor)#4.2
	fov (0.8/$distfactor)#1#0.87
	nearClip 0 
	farClip 150000
	select GameCinematics
	control -orient -orientHorizontal -snap
end

effect MMD_Camera
	camera MMD_Camera
end

effect Kanaria_Demon_Lord_Camera_Effect
	effect MMD_Camera -rotateXYZ -90 0 0
end
export Kanaria_Demon_Lord_Camera_Effect