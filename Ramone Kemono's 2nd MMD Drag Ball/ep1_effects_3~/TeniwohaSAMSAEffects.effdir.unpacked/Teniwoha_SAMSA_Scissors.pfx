include "Teniwoha_SAMSA_Time_Stamps.pfx"
create Teniwoha_SAMSA_Time_Stamps(0)

import Teniwoha_SAMSA_splattersingle

setf scissorsize 2
setf scissoroffset 1.15
setf scissorarcradius 4#8
particles scissorsclose
	#color (0.5,0.3,1) -vary 0.1
	life 2
	inject 1 -hold 1
	size $scissorsize*3
	rotate 0.5
	source -point
	align ZPole
	texture RamoneScissors5 -draw alphaTestDissolve -tile 2 2
	frames -speed 0 -start 0# -count 2 -random 1
end
particles scissorsopen
	#color (0.5,0.3,1) -vary 0.1
	life 2
	inject 1 -hold 1
	size $scissorsize*3
	rotate 0.5
	source -point
	align ZPole
	texture RamoneScissors5 -draw alphaTestDissolve -tile 2 2
	frames -speed 0 -start 1# -count 2 -random 1
end

effect scissors -rigid
	select
		particles scissorsclose
		particles scissorsopen
	end
end
effect scissorsDisplaced -rigid
	effect scissors -offset (0,0,$scissorsize*$scissoroffset)
end
effect scissorsDisplacedResized -rigid
	effect scissorsDisplaced# -sizeScale 
end

metaparticles scissorsTilted
	yaw 0#1 -vary 0.03
	pitch 0
	roll 1 -vary 0.06
	life 2
	inject 1 -hold 1
	source -point
	effect scissorsDisplacedResized
end
metaparticles Teniwoha_SAMSA_splatters
	yaw 0
	pitch 0
	roll 0
	life 2
	inject 3 -hold 1
	size 1 -vary 0.3
	source -circle 0.4
	effect Teniwoha_SAMSA_splattersingle
end
effect Teniwoha_SAMSA_splatters -rigid
	metaparticles Teniwoha_SAMSA_splatters
end
effect scissorsTilted -rigid
	metaparticles scissorsTilted
	effect Teniwoha_SAMSA_splatters  -offset(0,0,0.05)
end

effect scissorsDisplacedRadius -rigid
	effect scissorsTilted -offset (0,$scissorarcradius,0)
end

effect scissorsCollection -rigid
	effect scissorsDisplacedRadius -rotateZ 20
	effect scissorsDisplacedRadius -rotateZ	-20
	effect scissorsDisplacedRadius -rotateZ 35
	effect scissorsDisplacedRadius -rotateZ	-35
	effect scissorsDisplacedRadius -rotateZ 50
	effect scissorsDisplacedRadius -rotateZ	-50
end

effect scissorsCollectionoffset
	effect scissorsCollection -offset (0,-0*$scissorarcradius/2,0)
end

sequence scissorsCollectionoffsetTimed -noOverlap
	wait				($t10b)
	play scissorsCollectionoffset	($t11a-$t10b)
end
effect scissorsCollectionoffsetTimed -hardStop
	sequence scissorsCollectionoffsetTimed
end

effect Teniwoha_SAMSA_Scissors
	effect scissorsCollectionoffsetTimed
end

export Teniwoha_SAMSA_Scissors