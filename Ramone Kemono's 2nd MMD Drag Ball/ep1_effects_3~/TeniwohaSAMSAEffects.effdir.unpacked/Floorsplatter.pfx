#blacksplatter
setf totalsplatterradius 5
seti layernum 5
define splattersetting(i)
	source -point 
	align source
	life 2
	size (3.5*$totalsplatterradius/$layernum)
	rotate 2 -vary 1
	inject 1 -hold 1
enddef
particles splattersingle1
	create splattersetting(0)
	texture RamoneSplatter1 -draw alphaTestDissolve -sortOffset -0.21
end
particles splattersingle2
	create splattersetting(0)
	texture RamoneSplatter2 -draw alphaTestDissolve -sortOffset -0.21
end
effect splattersingle -rigid
	select
		particles splattersingle1
		particles splattersingle2
	end
end

define splatterring(order,ending,begin)
metaparticles splatterring&{order}
	yaw 0
	pitch 0
	roll 0
	life (200*$layernum)
	source -ring ((1+&{order})*$totalsplatterradius/$layernum) (1/(1+&{order}))
	inject ((1+&{order})*4) -delay ((1+&{order})*1) -hold (100*$layernum)
	effect splattersingle
end
enddef
create splatterring("0" "0" "0")
create splatterring("1" "0" "0")
create splatterring("2" "0" "0")
create splatterring("3" "0" "0")
create splatterring("4" "0" "0")

effect splattertimed -rigid
	metaparticles splatterring0
	metaparticles splatterring1
	metaparticles splatterring2
	metaparticles splatterring3
	metaparticles splatterring4
end

effect splatteroffset -rigid
	effect splattertimed -offset(0,0,0.05)
end